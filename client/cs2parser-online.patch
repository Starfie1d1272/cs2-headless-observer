index 0000000..7c1b08e
--- /dev/null
+++ b/src/parser/entities/nativeEntityFields.ts
@@ -0,0 +1,181 @@
+import type {BitBuffer} from '../ubitreader.js';
+import {readNativeFieldPaths} from './nativeFieldPaths.js';
+import {NativeSchema,type NativeMetadata,type NativeResolvedPath,type NativeSchemaField} from './nativeSchema.js';
+import type {NativeWireValue} from './nativeFieldCodec.js';
+
+export type NativeFieldRecord=Readonly<{
+ path:readonly number[];field:NativeSchemaField;
+ operation:NativeResolvedPath['operation'];value:NativeWireValue;
+}>;
+export type NativePointerState=Readonly<{present:boolean;selector?:number}>;
+export type NativeEntityFieldLimits=Readonly<{paths:number;arrayLength:number;records:number}>;
+const defaults:NativeEntityFieldLimits=Object.freeze({paths:65536,arrayLength:65536,records:262144});
+const key=(path:readonly number[])=>path.join('.');
+const copyValue=(value:NativeWireValue):NativeWireValue=>
+ value instanceof Uint8Array?value.slice():Array.isArray(value)?Object.freeze([...value]):value;
+
+/** Immutable logical fields; retained serialized metadata is a separate owner. */
+export class NativeEntityFields {
+ private constructor(
+  readonly schema:NativeSchema,readonly classId:number,
+  private readonly values:Map<string,NativeFieldRecord>,
+  private readonly metadata:Map<string,NativeMetadata>,
+  private readonly pointers:Map<string,NativePointerState>,
+ ) {}
+ static empty(schema:NativeSchema,classId:number):NativeEntityFields {
+  schema.getClass(classId);
+  return new NativeEntityFields(schema,classId,new Map(),new Map(),new Map());
+ }
+ get fieldCount(){return this.values.size;}
+ getMetadata(path:readonly number[]):NativeMetadata|undefined{return this.metadata.get(key(path));}
+ getPointer(path:readonly number[]):NativePointerState|undefined{return this.pointers.get(key(path));}
+ get(path:readonly number[]):NativeFieldRecord|undefined {
+  const record=this.values.get(key(path));
+  return record&&Object.freeze({...record,value:copyValue(record.value)});
+ }
+ *entries():IterableIterator<NativeFieldRecord> {
+  for(const record of this.values.values())yield Object.freeze({...record,value:copyValue(record.value)});
+ }
+
+ /** Apply a stored sparse baseline to an existing logical object. Omitted
+  * baseline fields do not erase reused same-class/same-serial entity fields.
+  * Container and pointer operations still own their descendant lifetimes.
+  */
+ applyTo(previous:NativeEntityFields):NativeEntityFields {
+  if(previous.schema!==this.schema||previous.classId!==this.classId)throw new Error('Entity schema identity mismatch');
+  const values=new Map(previous.values),metadata=new Map(previous.metadata),pointers=new Map(previous.pointers);
+  const sorted=[...this.values.values()].sort((a,b)=>{
+   for(let i=0;i<Math.min(a.path.length,b.path.length);i++)if(a.path[i]!==b.path[i])return a.path[i]!-b.path[i]!;
+   return a.path.length-b.path.length;
+  });
+  const prune=(path:readonly number[],minimum?:number)=>{
+   const prefix=key(path)+'.';
+   const remove=(candidate:string)=>candidate.startsWith(prefix)&&
+    (minimum===undefined||Number(candidate.slice(prefix.length).split('.',1)[0])>=minimum);
+   for(const candidate of values.keys())if(remove(candidate))values.delete(candidate);
+   for(const candidate of pointers.keys())if(remove(candidate))pointers.delete(candidate);
+  };
+  for(const record of sorted){
+   const resolved=this.schema.resolve(this.classId,record.path,path=>this.metadata.get(key(path)));
+   for(const ancestor of resolved.ancestors){
+    if(ancestor.kind!=='pointer')continue;
+    const ancestorKey=key(ancestor.path),next=this.pointers.get(ancestorKey);
+    if(!next?.present)throw new Error('Stored field below absent pointer');
+    const old=pointers.get(ancestorKey);
+    if(old?.present!==true||old.selector!==next.selector)prune(ancestor.path);
+    pointers.set(ancestorKey,next);
+    if(next.selector===undefined)metadata.delete(ancestorKey);
+   }
+   const name=key(record.path);
+   if(record.operation==='array')prune(record.path,record.value as number);
+   if(record.operation==='pointer'){
+    const next=this.pointers.get(name);
+    if(!next)throw new Error('Missing stored pointer state');
+    const old=pointers.get(name);
+    if(!next.present||old?.present!==true||old.selector!==next.selector)prune(record.path);
+    pointers.set(name,next);
+   }
+   values.set(name,record);
+  }
+  // Serialized metadata and implicit pointer ancestors can exist without a
+  // separate transmitted root value; preserve their independent ownership.
+  for(const [name,value] of this.metadata)metadata.set(name,value);
+  for(const [name,value] of this.pointers)if(!pointers.has(name))pointers.set(name,value);
+  if(values.size>defaults.records||metadata.size>defaults.records||pointers.size>defaults.records)
+   throw new Error('Entity field storage budget');
+  return new NativeEntityFields(this.schema,this.classId,values,metadata,pointers);
+ }
+
+ /**
+  * Work on private copies. Nothing is published until the entire field block
+  * succeeds; the snapshot owner still controls the later packet-level commit.
+  */
+ static decode(
+  schema:NativeSchema,classId:number,reader:BitBuffer,previous:NativeEntityFields,
+  bitLength?:number,limits:NativeEntityFieldLimits=defaults,
+ ):Readonly<{state:NativeEntityFields;consumedBits:number;changedPaths:readonly (readonly number[])[]}> {
+  if(previous.schema!==schema||previous.classId!==classId)throw new Error('Entity schema identity mismatch');
+  for(const name of ['paths','arrayLength','records'] as const) {
+   const value=limits[name];
+   if(!Number.isSafeInteger(value)||value<0||value>1_000_000)throw new Error('Invalid entity field limit: '+name);
+  }
+  const initialBits=reader.RemainingBits;
+  if(bitLength!==undefined&&(!Number.isSafeInteger(bitLength)||bitLength<0||bitLength>initialBits))
+   throw new Error('Invalid entity field bit length');
+  const budget=bitLength??initialBits;
+  const paths=readNativeFieldPaths(reader,limits.paths,budget);
+  const values=new Map(previous.values),metadata=new Map(previous.metadata),pointers=new Map(previous.pointers);
+  const meta=(prefix:readonly number[])=>metadata.get(key(prefix));
+  const removeDescendants=(prefix:readonly number[],minimumIndex?:number)=>{
+   const start=key(prefix)+'.';
+   const removed=(candidate:string)=>{
+    if(!candidate.startsWith(start))return false;
+    if(minimumIndex===undefined)return true;
+    const index=Number(candidate.slice(start.length).split('.',1)[0]);
+    return index>=minimumIndex;
+   };
+   for(const candidate of values.keys())if(removed(candidate))values.delete(candidate);
+   for(const candidate of pointers.keys())if(removed(candidate))pointers.delete(candidate);
+   // Native delta metadata merge retains dormant descendant records. They
+   // must not be confused with visible logical fields or live pointer objects.
+  };
+  for(const path of paths) {
+   const resolved=schema.resolve(classId,path,meta);
+   for(const ancestor of resolved.ancestors) {
+    if(ancestor.kind==='pointer'&&pointers.get(key(ancestor.path))?.present===false)
+     throw new Error('Field below absent pointer');
+   }
+   const name=key(path),field=resolved.field;
+   let value:NativeWireValue;
+   if(resolved.operation==='array') {
+    if(!field.container)throw new Error('Missing array definition');
+    // Ordinary fixed-array accessors use the declared extent without a wire
+    // resize value. Dynamic vectors carry a varuint length.
+    const size=field.container.kind==='fixed'?field.container.size:reader.ReadUVarInt32();
+    if(!Number.isSafeInteger(size)||size<0||size>limits.arrayLength)throw new Error('Array length budget');
+    removeDescendants(path,size);
+    metadata.set(name,Object.freeze({kind:0,value:size}));
+    value=size;
+   } else if(resolved.operation==='pointer') {
+    const present=reader.readBoolean();
+    let selector:number|undefined;
+    if(present&&field.variants.length) {
+     selector=reader.readUbitVar();
+     if(!Number.isInteger(selector)||selector<1||selector>field.variants.length)
+      throw new Error('Invalid polymorphic pointer selector');
+    }
+    const old=pointers.get(name);
+    if(!present||old?.present!==true||old.selector!==selector)removeDescendants(path);
+    pointers.set(name,Object.freeze({present,...(selector===undefined?{}:{selector})}));
+    if(selector!==undefined)metadata.set(name,Object.freeze({kind:1,value:selector}));
+    value=present;
+   } else {
+    if(!field.codec)throw new Error('Missing field codec');
+    value=field.codec(reader);
+   }
+   if(initialBits-reader.RemainingBits>budget)throw new Error('Entity field boundary exceeded');
+   // A successfully decoded descendant establishes that its pointer ancestors
+   // are present, even when a baseline did not include their presence field.
+   for(const ancestor of resolved.ancestors) {
+    if(ancestor.kind!=='pointer')continue;
+    const ancestorKey=key(ancestor.path);
+    if(!pointers.has(ancestorKey)) {
+     const active=meta(ancestor.path);
+     pointers.set(ancestorKey,Object.freeze({present:true,
+      ...(active?.kind===1?{selector:active.value}:{})}));
+    }
+   }
+   values.set(name,Object.freeze({path,field,operation:resolved.operation,value:copyValue(value)}));
+   if(values.size>limits.records||metadata.size>limits.records||pointers.size>limits.records)
+    throw new Error('Entity field storage budget');
+  }
+  const consumedBits=initialBits-reader.RemainingBits;
+  if(bitLength!==undefined&&consumedBits!==bitLength)throw new Error('Entity field length mismatch');
+  if(values.size>limits.records||metadata.size>limits.records||pointers.size>limits.records)
+   throw new Error('Entity field storage budget');
+  return Object.freeze({
+   state:new NativeEntityFields(schema,classId,values,metadata,pointers),
+   consumedBits,changedPaths:paths,
+  });
+ }
+}
diff --git a/src/parser/entities/nativeEventProjection.ts b/src/parser/entities/nativeEventProjection.ts
new file mode 100644
index 0000000..d523281
--- /dev/null
+++ b/src/parser/entities/nativeEventProjection.ts
@@ -0,0 +1,61 @@
+import {CMsgPlayerInfo} from '../../ts-proto/networkbasetypes.js';
+import type {NativeSnapshotState,NativeEntity} from './nativeSnapshotState.js';
+import type {NativeStringTables} from './nativeStringTables.js';
+import type {NativeSchema} from './nativeSchema.js';
+import type {NativeWireValue} from './nativeFieldCodec.js';
+const steamId=(value:unknown)=>typeof value==='bigint'||typeof value==='string'?(/^7656119\d{10}$/.test(String(value))?String(value):null):null;
+const field=(entity:NativeEntity,name:string):NativeWireValue=>{
+ let found:NativeWireValue;let count=0;
+ for(const record of entity.fields.entries())if(record.field.name===name&&record.operation==='value'){found=record.value;count++;}
+ return count===1?found:undefined;
+};
+export interface NativePlayerIdentity {
+ readonly domain:'player-controller-slot';
+ readonly slot:number;
+ readonly steamId:string;
+ readonly userId:number|null;
+ readonly controller:Readonly<{index:number;serial:number}>;
+}
+/** No historical slot guessing: a missing/mismatched identity remains null. */
+export function projectNativeEvent(schema:NativeSchema|undefined,snapshots:NativeSnapshotState,tables:NativeStringTables,
+ name:string,fields:Readonly<Record<string,unknown>>,types:ReadonlyMap<string,number>){
+ const player=(key:string):NativePlayerIdentity|null=>{
+  if(!schema||snapshots.waitingFull||types.get(key)!==9)return null;
+  const raw=fields[key];if(typeof raw!=='number'||!Number.isInteger(raw))return null;
+  const value=raw&65535;if(value===65535)return null;const slot=value&255;
+  const controller=snapshots.getEntity(slot+1);
+  if(!controller||!schema.getClass(controller.classId).name.endsWith('PlayerController'))return null;
+  const id=steamId(field(controller,'m_steamID'));if(!id)return null;
+  const info=tables.entryByName('userinfo',slot);if(!info?.value.length)return null;
+  let stored;try{stored=CMsgPlayerInfo.decode(info.value);}catch{return null;}
+  if(stored.fakeplayer||stored.ishltv||(steamId(stored.xuid)??steamId(stored.steamid))!==id)return null;
+  const pawnKey=key+'_pawn';
+  if(types.get(pawnKey)===8){
+   const rawPawn=fields[pawnKey];if(typeof rawPawn!=='number'||!Number.isInteger(rawPawn))return null;
+   const handle=rawPawn>>>0;if(handle===0xffffffff||handle===0xfffffffe)return null;
+   const pawn=snapshots.getEntity(handle&0x7fff);
+   if(!pawn||pawn.serial!==(handle>>>15))return null;
+   // Controller's field uses the DIFFERENT compressed14/10-bit handle domain.
+   const linked=field(controller,'m_hPlayerPawn')??field(controller,'m_hPawn');
+   if(typeof linked!=='number'||(linked&0x3fff)!==pawn.id||((linked>>>14)&0x3ff)!==(pawn.serial&0x3ff))return null;
+  }
+  return Object.freeze({domain:'player-controller-slot' as const,slot,steamId:id,
+   userId:typeof stored.userid==='number'&&Number.isInteger(stored.userid)&&stored.userid>0?stored.userid:null,
+   controller:Object.freeze({index:controller.id,serial:controller.serial})});
+ };
+ let warmup:boolean|null=null,round:number|null=null;
+ if(schema&&!snapshots.waitingFull){
+  for(const entity of snapshots.entries())if(schema.getClass(entity.classId).name==='CCSGameRulesProxy'){
+   const w=field(entity,'m_bWarmupPeriod'),r=field(entity,'m_totalRoundsPlayed');
+   warmup=typeof w==='boolean'?w:null;round=typeof r==='number'&&Number.isInteger(r)?r:null;break;
+  }
+ }
+ const players:Record<string,NativePlayerIdentity|null>=Object.create(null);
+ for(const [key,type] of types)if(type===9)players[key]=player(key);
+ Object.freeze(players);
+ const actor=name==='player_death'?players.attacker?.steamId??null:name==='weapon_fire'?players.userid?.steamId??null:null;
+ const target=name==='player_death'?players.userid?.steamId??null:null;
+ return Object.freeze({actor,target,warmup,round,players,
+  weapon:typeof fields.weapon==='string'?fields.weapon:null,
+  identityResolved:name==='weapon_fire'?actor!==null:name==='player_death'?actor!==null&&target!==null:false});
+}
diff --git a/src/parser/entities/nativeFieldCodec.ts b/src/parser/entities/nativeFieldCodec.ts
new file mode 100644
index 0000000..3394cbe
--- /dev/null
+++ b/src/parser/entities/nativeFieldCodec.ts
@@ -0,0 +1,135 @@
+import type { BitBuffer } from '../ubitreader.js';
+import { createNativeFieldQuantizer, decodeNativeQuantized } from './nativeQuantizedFloat.js';
+
+/** Fixed-build wire values. Accessors/projection own storage narrowing and identity. */
+export type NativeFloat = number | Readonly<{ kind: 'float32-nonfinite'; bits: number }>;
+export type NativeWireValue = NativeFloat | bigint | boolean | Uint8Array | readonly NativeFloat[] | undefined;
+export type NativeCoordinateProfile = Readonly<{
+ integer: number; fraction: number; integerMp: number; fractionMp: number; normal: number; angle: number;
+}>;
+export type NativeFieldEncoding = Readonly<{
+ category: number; dimensions: number; encoder?: string;
+ bit_count?: number; encode_flags?: number; low_value?: number; high_value?: number;
+}>;
+export type NativeCodec = (reader: BitBuffer) => NativeWireValue;
+const f = Math.fround;
+const floatView = new DataView(new ArrayBuffer(4));
+function readRawFloat32(r: BitBuffer): NativeFloat {
+ const bits=r.ReadUBits(32);
+ if((bits&0x7f800000)===0x7f800000)return Object.freeze({kind:'float32-nonfinite',bits});
+ floatView.setUint32(0,bits,true);return floatView.getFloat32(0,true);
+}
+
+export function nativeCoordinateProfile(input?: {
+ coord_integer_bits?: number; coord_fractional_bits?: number; coord_integer_bits_mp?: number;
+ coord_fractional_bits_mp?: number; normal_fractional_bits?: number; angle_bits?: number;
+}): NativeCoordinateProfile {
+ const values = input ? [input.coord_integer_bits,input.coord_fractional_bits,input.coord_integer_bits_mp,
+  input.coord_fractional_bits_mp,input.normal_fractional_bits,input.angle_bits] : [14,5,11,3,11,20];
+ if (values.some(v => !Number.isInteger(v) || v! < 1 || v! > 31)) throw new Error('Invalid coordinate profile');
+ const [integer,fraction,integerMp,fractionMp,normal,angle] = values as [number,number,number,number,number,number];
+ if (Math.max(integer,integerMp)+3+Math.max(fraction,fractionMp)>32) throw new Error('Coordinate profile bit budget');
+ return Object.freeze({integer,fraction,integerMp,fractionMp,normal,angle});
+}
+function readCoord(r: BitBuffer,p: NativeCoordinateProfile): number {
+ const integer=r.readBoolean(),fraction=r.readBoolean();
+ if (!integer&&!fraction) return 0;
+ const negative=r.readBoolean(),whole=integer?r.ReadUBits(p.integer)+1:0;
+ const part=fraction?f(r.ReadUBits(p.fraction)*f(2**-p.fraction)):0;
+ const value=f(f(whole)+part);return negative?-value:value;
+}
+function readIntegral(r: BitBuffer,p: NativeCoordinateProfile): number {
+ const compact=r.readBoolean();if(!r.readBoolean())return 0;
+ const negative=r.readBoolean(),value=f(r.ReadUBits(compact?p.integerMp:p.integer)+1);
+ return negative?-value:value;
+}
+function presentTriple(r: BitBuffer,read:()=>number): number[] {
+ const present=[r.readBoolean(),r.readBoolean(),r.readBoolean()];
+ return present.map(on=>on?read():0);
+}
+function readNormal(r: BitBuffer,p: NativeCoordinateProfile): number[] {
+ const x=r.readBoolean(),y=r.readBoolean(),scale=f(1/(2**p.normal-1));
+ const component=()=>{const sign=r.readBoolean(),value=f(r.ReadUBits(p.normal)*scale);return sign?-value:value;};
+ const a=x?component():0,b=y?component():0,negative=r.readBoolean();
+ const sum=f(f(a*a)+f(b*b)),z=sum<1?f(Math.sqrt(f(1-sum))):0;
+ return [a,b,negative?-z:z];
+}
+function unsigned32(r: BitBuffer): number {
+ let value=0;
+ for(let n=0;n<5;n++){
+  const byte=r.ReadByte();if(n===4&&byte>15)throw new Error('Unsigned varint32 overflow');
+  value|=(byte&127)<<(n*7);if(!(byte&128))return value>>>0;
+ }
+ throw new Error('Unterminated varint32');
+}
+function bytes(r: BitBuffer,size:number,limit:number): Uint8Array {
+ if(!Number.isSafeInteger(size)||size<0||size>limit||size*8>r.RemainingBits)throw new Error('Binary field budget');
+ const result=new Uint8Array(size);r.readBytes(result);return result;
+}
+/** Bounds are observer policy, not protocol constants. Strings preserve original bytes. */
+export function createNativeFieldCodec(field:NativeFieldEncoding,p:NativeCoordinateProfile,
+ limits:Readonly<{stringBytes:number;binaryBytes:number}>={stringBytes:65536,binaryBytes:4*1024*1024}):NativeCodec {
+ const {category,dimensions:dim}=field,encoder=(field.encoder??'default').toLowerCase();
+ if(!Number.isInteger(category)||category<0||category>7||!Number.isInteger(dim)||dim<(category===6?0:1))throw new Error('Invalid native wire type');
+ if(!Number.isSafeInteger(limits.stringBytes)||limits.stringBytes<1||!Number.isSafeInteger(limits.binaryBytes)||limits.binaryBytes<0)throw new Error('Invalid field limits');
+ const stringLimit=limits.stringBytes,binaryLimit=limits.binaryBytes;
+ if(category===3){
+  if(![1,2,3,4,6,8].includes(dim))throw new Error('Unsupported float dimension');
+  if(encoder==='default'){
+   const q=createNativeFieldQuantizer(field);
+   return r=>{const read=()=>q.raw?readRawFloat32(r):decodeNativeQuantized(r,q);return dim===1?read():Array.from({length:dim},read);};
+  }
+  if(encoder==='coord'||encoder==='coord_integral'){
+   if(![1,3,6,8].includes(dim))throw new Error('Unsupported coordinate dimension');
+   const first=encoder==='coord'?readCoord:readIntegral;
+   return r=>{
+    if(dim===1)return first(r,p);
+    const values=[first(r,p),first(r,p),first(r,p)];
+    if(dim===6||dim===8)values.push(...presentTriple(r,()=>readCoord(r,p)));
+    return values; // dimension8 retains the six matrix-conversion inputs, not a render matrix.
+   };
+  }
+  if(encoder==='normal'){
+   if(dim!==3)throw new Error('Unsupported normal dimension');return r=>readNormal(r,p);
+  }
+  if(['qangle','qangle_precise','qangle_pitch_yaw'].includes(encoder)){
+   if(dim!==3)throw new Error('Unsupported angle dimension');
+   const width=field.bit_count??0;
+   if(!Number.isInteger(width)||width<0||width>32)throw new Error('Invalid angle bitcount');
+   const count=encoder==='qangle_pitch_yaw'?2:3;
+   return r=>{
+    if(width===0&&encoder==='qangle')return presentTriple(r,()=>readCoord(r,p));
+    if(width===0&&encoder==='qangle_precise')return presentTriple(r,()=>f(f(r.ReadUBits(p.angle)*(360/2**p.angle))-180));
+    const raw=encoder!=='qangle_precise'&&(width===0||width===32);
+    const values=Array.from({length:count},()=>raw?readRawFloat32(r):f((r.ReadUBits(width)|0)*(360/(2**(width&31)))));
+    if(count===2)values.push(0);return values;
+   };
+  }
+  throw new Error('Unsupported float encoder: '+encoder);
+ }
+ if(dim!==1&&!(category===6&&dim===0))throw new Error('Unsupported scalar dimension');
+ if(category===1||category===2){
+  const signed=category===1;
+  switch(encoder){
+   case 'default':return r=>{const value=r.readUVarInt64();return signed?(value>>1n)^-(value&1n):value;};
+   case 'fixed8':return r=>{const value=r.ReadUBits(8);return signed?(value<<24)>>24:value;};
+   case 'fixed32':return r=>{const value=r.ReadUBits(32);return signed?value|0:value;};
+   case 'fixed64':return r=>{const value=BigInt(r.ReadUBits(32))|(BigInt(r.ReadUBits(32))<<32n);return signed?BigInt.asIntN(64,value):value;};
+   default:throw new Error('Unsupported integer encoder: '+encoder);
+  }
+ }
+ if(encoder!=='default')throw new Error('Unsupported scalar encoder: '+encoder);
+ if(category===0)return ()=>undefined;
+ if(category===4)return r=>readRawFloat32(r); // native double-family wire encoding is float32
+ if(category===7)return r=>r.readBoolean();
+ if(category===6)return r=>bytes(r,unsigned32(r),binaryLimit);
+ if(category===5)return r=>{
+  const result:number[]=[];
+  for(let n=0;n<=stringLimit;n++){
+   const value=r.ReadByte();if(!value)return Uint8Array.from(result);
+   if(n===stringLimit)break;result.push(value);
+  }
+  throw new Error('String field budget');
+ };
+ throw new Error('Unsupported native wire type');
+}
diff --git a/src/parser/entities/nativeFieldPaths.ts b/src/parser/entities/nativeFieldPaths.ts
new file mode 100644
index 0000000..a34dcd2
--- /dev/null
+++ b/src/parser/entities/nativeFieldPaths.ts
@@ -0,0 +1,101 @@
+import type {BitBuffer} from '../ubitreader.js';
+import {doOp, popSpecial, type FieldPath} from './fieldPathOps.js';
+import {fillHuffmanTables} from './fieldPaths.js';
+
+const primary=new Uint16Array(256);
+const long=new Uint16Array(1<<17);
+fillHuffmanTables(primary,long);
+const maxDepth=10;
+const fixedPush=new Map<number,number>([
+  ...Array.from({length:8},(_,i)=>[i+5,1] as const),
+  [13,2],[14,2],[15,3],[16,3],[17,2],[18,2],[19,3],[20,3],
+  [21,2],[22,2],[23,3],[24,3],
+]);
+
+export function createNativePathState():FieldPath {
+  // The legacy public type is a seven-element tuple; its proven opcode
+  // functions work on an array. This ordinary-viewer state has native depth10.
+  const path=new Array<number>(maxDepth).fill(0) as unknown as FieldPath['path'];
+  path[0]=-1;
+  return {path,last:0};
+}
+function requirePush(state:FieldPath,count:number) {
+  if(!Number.isInteger(count)||count<0||state.last+1+count>maxDepth)
+    throw new Error('Field path depth overflow');
+}
+function requirePop(state:FieldPath,count:number) {
+  if(!Number.isInteger(count)||count<0||count>state.last)
+    throw new Error('Field path depth underflow');
+}
+
+/** Reuse verified opcode arithmetic, adding bounded variable-depth handling. */
+export function applyNativePathOperation(op:number,reader:BitBuffer,state:FieldPath):void {
+  if(!Number.isInteger(state.last)||state.last<0||state.last>=maxDepth||state.path.length<maxDepth)
+    throw new Error('Invalid field path state');
+  if(!Number.isInteger(op)||op<0||op>39)throw new Error('Invalid field path opcode');
+  if(op===39) {
+    state.path.fill(0);state.path[0]=32767;state.last=0;return;
+  }
+  const push=fixedPush.get(op);
+  if(push!==undefined)requirePush(state,push);
+  if(op===27||op===28||op===37)requirePop(state,1);
+  if(op===25) {
+    const count=reader.readUbitVar();
+    requirePush(state,count);
+    state.path[state.last]!+=reader.readUbitVar();
+    for(let i=0;i<count;i++)state.path[++state.last]!+=reader.readUbitVarFp();
+  } else if(op===26) {
+    for(let i=0;i<=state.last;i++)
+      if(reader.readBoolean())state.path[i]!+=reader.readVarInt32()+1;
+    const count=reader.readUbitVar();
+    requirePush(state,count);
+    for(let i=0;i<count;i++)state.path[++state.last]=reader.readUbitVarFp();
+  } else if(op>=33&&op<=35) {
+    const count=reader.readUbitVarFp();
+    requirePop(state,count);popSpecial(state,count);
+    if(op===33)state.path[state.last]!+=1;
+    else if(op===34)state.path[state.last]!+=reader.readVarInt32();
+    else for(let i=0;i<=state.last;i++)
+      if(reader.readBoolean())state.path[i]!+=reader.readVarInt32();
+  } else {
+    doOp(op,reader,state);
+  }
+  if(state.last<0||state.last>=maxDepth)throw new Error('Invalid field path depth');
+  for(let i=0;i<=state.last;i++) {
+    const value=state.path[i]!;
+    if(!Number.isSafeInteger(value))throw new Error('Invalid field path component');
+    // Native CFieldPath stores signed16 components. Final schema resolution,
+    // not arithmetic success alone, decides whether the wrapped path is valid.
+    state.path[i]=(value<<16)>>16;
+  }
+}
+
+/**
+ * Decode a complete field list before exposing it. Budgets are observer policy;
+ * failure discards the list and its owning entity/snapshot transaction.
+ */
+export function readNativeFieldPaths(reader:BitBuffer,maxPaths=65536,bitBudget=reader.RemainingBits):readonly (readonly number[])[] {
+  if(!Number.isSafeInteger(maxPaths)||maxPaths<0||maxPaths>1_000_000)
+    throw new Error('Invalid field-list budget');
+  const initialBits=reader.RemainingBits;
+  if(!Number.isSafeInteger(bitBudget)||bitBudget<0||bitBudget>initialBits)
+    throw new Error('Invalid field-list bit boundary');
+  const state=createNativePathState();
+  const result:(readonly number[])[]=[];
+  while(true) {
+    const prefix=reader.peekHuffmanPrefix();
+    const code=primary[prefix]||long[reader.peekHuffmanCode()]!;
+    const width=code>>>6,op=code&63;
+    if(width<1||width>17||op>39)throw new Error('Invalid Huffman field path');
+    if(initialBits-reader.RemainingBits+width>bitBudget)throw new Error('Truncated field-list code');
+    reader.consumePeeked(width);
+    applyNativePathOperation(op,reader,state);
+    if(initialBits-reader.RemainingBits>bitBudget)throw new Error('Truncated field-list payload');
+    // PlusN can reach the same root sentinel as explicit opcode39.
+    if(state.path[0]===32767)return Object.freeze(result);
+    const path=state.path.slice(0,state.last+1);
+    if(path.some(value=>value<0||value>32767))throw new Error('Invalid resolved field path');
+    if(result.length>=maxPaths)throw new Error('Field-list budget exceeded');
+    result.push(Object.freeze(path));
+  }
+}
diff --git a/src/parser/entities/nativeObserverCore.ts b/src/parser/entities/nativeObserverCore.ts
new file mode 100644
index 0000000..7991416
--- /dev/null
+++ b/src/parser/entities/nativeObserverCore.ts
@@ -0,0 +1,161 @@
+import {CSVCMsg_ServerInfo,CSVCMsg_FlattenedSerializer,CSVCMsg_ClassInfo,CSVCMsg_CreateStringTable,CSVCMsg_UpdateStringTable,CSVCMsg_PacketEntities} from '../../ts-proto/netmessages.js';
+import {CNETMsg_Tick} from '../../ts-proto/networkbasetypes.js';
+import {CMsgSource1LegacyGameEventList,CMsgSource1LegacyGameEvent,type CMsgSource1LegacyGameEventList_descriptor_t} from '../../ts-proto/gameevents.js';
+import {SnappyDecoder} from '../../compression/wasm.js';
+import {NativeStringTables} from './nativeStringTables.js';
+import {NativeSchema} from './nativeSchema.js';
+import {NativeSnapshotState} from './nativeSnapshotState.js';
+import {NativePacketEntities} from './nativePacketEntities.js';
+import {projectNativeEvent} from './nativeEventProjection.js';
+
+export type NativeSourceIdentity=Readonly<{source:string;channel:number;world:number}>;
+export type NativeMessageEnvelope=Readonly<NativeSourceIdentity&{sequence:number;messageId:number;body:Uint8Array;contextTick?:number}>;
+export type NativeCoreRecord=Readonly<NativeSourceIdentity&{sequence:number;tick:number;type:string;[name:string]:unknown}>;
+
+/** Ordered, synchronous data-plane decoder. Actual SDK/transport/control state
+ * stays in its parent; this class never authenticates, sends ACKs or claims FULL.
+ * Outputs carry generation fences so the parent can reject retired receipts.
+ */
+export class NativeObserverCore {
+ private identity:NativeSourceIdentity;
+ private sequence=0;
+ private tick=-1;
+ private lastCursor=-Infinity;
+ private tables=new NativeStringTables(new SnappyDecoder());
+ private snapshots=new NativeSnapshotState();
+ private server:CSVCMsg_ServerInfo|undefined;
+ private serializers:CSVCMsg_FlattenedSerializer|undefined;
+ private classes:CSVCMsg_ClassInfo|undefined;
+ private schema:NativeSchema|undefined;
+ private packets:NativePacketEntities|undefined;
+ private descriptors=new Map<number,CMsgSource1LegacyGameEventList_descriptor_t>();
+ private descriptorGeneration=0;
+ private knownCreationSequence=-1;
+ private halted=false;
+ constructor(identity:NativeSourceIdentity){this.validateIdentity(identity);this.identity=Object.freeze({...identity});}
+ private validateIdentity(identity:NativeSourceIdentity){
+  if(typeof identity.source!=='string'||!identity.source||identity.source.length>128||![identity.channel,identity.world].every(v=>Number.isSafeInteger(v)&&v>=0))throw new Error('Invalid source identity');
+ }
+ get currentIdentity(){return this.identity;}
+ get ready(){return !this.halted&&this.schema!==undefined&&this.server!==undefined;}
+ get committedTick(){return this.snapshots.lastTick;}
+ /** This is evidence supplied by the control/world owner, never inferred from
+  * a PacketEntities request for a future creation sequence. */
+ admitCreationSequence(sequence:number){
+  if(!Number.isInteger(sequence)||sequence<0||sequence>0xffffffff||sequence<this.knownCreationSequence)throw new Error('Invalid admitted creation sequence');
+  this.knownCreationSequence=sequence;
+ }
+ resetWorld(identity:NativeSourceIdentity){
+  this.validateIdentity(identity);
+  if(identity.source!==this.identity.source||identity.channel!==this.identity.channel||identity.world<=this.identity.world)
+   throw new Error('Invalid world transition');
+  this.identity=Object.freeze({...identity});this.tick=-1;this.lastCursor=-Infinity;this.tables.clear();this.snapshots.reset();
+  this.server=undefined;this.serializers=undefined;this.classes=undefined;this.schema=undefined;this.packets=undefined;
+  this.descriptors.clear();this.descriptorGeneration++;this.knownCreationSequence=-1;this.halted=false;
+ }
+ private build(){
+  if(this.schema||!this.server||!this.serializers||!this.classes)return;
+  const max=this.server.max_classes;if(max===undefined)throw new Error('Missing ServerInfo max_classes');
+  if(!this.classes.classes.length||this.classes.classes.some(c=>c.class_id===undefined||c.class_id>=this.classes!.classes.length))throw new Error('ClassInfo index exceeds announced class count');
+  const schema=new NativeSchema(this.serializers,this.classes.classes.map(c=>({class_id:c.class_id,network_name:c.class_name})),max);
+  this.schema=schema;this.packets=new NativePacketEntities(schema,this.snapshots,this.tables);
+ }
+ consume(input:NativeMessageEnvelope):readonly NativeCoreRecord[]{
+  if(input.source!==this.identity.source||input.channel!==this.identity.channel||input.world!==this.identity.world)
+   throw new Error('Retired message generation');
+  if(input.sequence!==this.sequence+1||!Number.isSafeInteger(input.sequence))throw new Error('Message sequence mismatch');
+  if(!Number.isInteger(input.messageId)||input.messageId<0||input.body.length>4*1024**2)throw new Error('Message envelope budget');
+  if(input.contextTick!==undefined&&(!Number.isInteger(input.contextTick)||input.contextTick< -0x80000000||input.contextTick>0x7fffffff))throw new Error('Invalid transport message tick');
+  this.sequence=input.sequence;
+  const output:NativeCoreRecord[]=[];
+  const record=(type:string,data:Record<string,unknown>={})=>output.push(Object.freeze({...this.identity,sequence:this.sequence,tick:input.contextTick??this.tick,networkTick:this.tick,type,...data}));
+  if(this.halted){record('blocked',{reason:'world-reinitialization-required'});return Object.freeze(output);}
+  try{
+   switch(input.messageId){
+    case 4:{const msg=CNETMsg_Tick.decode(input.body);if(msg.tick===undefined||msg.tick<0||msg.tick>0x7fffffff)throw new Error('Invalid network clock');this.tick=msg.tick;break;}
+    case 40:{
+     const msg=CSVCMsg_ServerInfo.decode(input.body);
+     if(this.server&&(['server_count','map_name','max_classes','protocol','tick_interval'] as const).some(key=>this.server![key]!==msg[key]))throw new Error('ServerInfo changed without world boundary');
+     if(!(msg.tick_interval!>0&&msg.tick_interval!<=1)||!msg.map_name)throw new Error('Invalid ServerInfo clock/map');
+     this.server=msg;this.build();break;
+    }
+    case 41:if(this.schema)throw new Error('Serializer replacement needs world boundary');this.serializers=CSVCMsg_FlattenedSerializer.decode(input.body);this.build();break;
+    case 42:{
+     const msg=CSVCMsg_ClassInfo.decode(input.body);
+     if(msg.create_on_client){if(!this.schema)throw new Error('Cached classes unavailable');break;}
+     if(this.schema)throw new Error('Class replacement needs world boundary');this.classes=msg;this.build();break;
+    }
+    case 44:this.tables.create(CSVCMsg_CreateStringTable.decode(input.body));break;
+    case 45:this.tables.update(CSVCMsg_UpdateStringTable.decode(input.body));break;
+    case 51:{
+     this.resetWorld({...this.identity,world:this.identity.world+1});
+     record('world-reset',{reason:'clear-all-string-tables'});break;
+    }
+    case 55:{
+     if(!this.packets)throw new Error('Entities before schema readiness');
+     const msg=CSVCMsg_PacketEntities.decode(input.body);
+     if(msg.max_spawngroup_creationsequence!==undefined&&msg.max_spawngroup_creationsequence>this.knownCreationSequence)
+      throw new Error('Snapshot exceeds admitted world creation sequence');
+     const priorEpoch=this.snapshots.epoch;
+     const receipt=this.packets.decode(msg,input.contextTick??this.tick);
+     if(receipt){
+      record('receipt',receipt);
+      if(receipt.epoch!==priorEpoch){record('gap',{reason:'snapshot-epoch-restarted'});this.lastCursor=-Infinity;}
+      if(this.server?.tick_interval&&(receipt.tick-this.lastCursor)*this.server.tick_interval>=1){
+       this.lastCursor=receipt.tick;
+       record('cursor',{map:this.server.map_name??null,tickInterval:this.server.tick_interval,
+        ...projectNativeEvent(this.schema,this.snapshots,this.tables,'cursor',{},new Map())});
+      }
+     }
+     break;
+    }
+    case 70:break; // Ordinary forward handler021ba0; optional replay is not live state.
+    case 205:{
+     const msg=CMsgSource1LegacyGameEventList.decode(input.body),next=new Map<number,CMsgSource1LegacyGameEventList_descriptor_t>();
+     if(msg.descriptors.length>512)throw new Error('Event descriptor budget');
+     for(const d of msg.descriptors){
+      if(d.eventid===undefined||d.eventid<0||d.eventid>=512||!d.name||d.name.length>256||next.has(d.eventid)||d.keys.length>256)
+       throw new Error('Invalid event descriptor');
+      const names=new Set<string>();for(const k of d.keys){if(!k.name||k.name.length>256||names.has(k.name)||k.type===undefined||k.type<0||k.type>9)throw new Error('Invalid event key descriptor');names.add(k.name);}
+      next.set(d.eventid,d);
+     }
+     this.descriptors=next;this.descriptorGeneration++;
+     record('event-subscriptions',{descriptorGeneration:this.descriptorGeneration,ids:Object.freeze([...next.keys()]),playerSlot:this.server?.player_slot??null});break;
+    }
+    case 207:{
+     const msg=CMsgSource1LegacyGameEvent.decode(input.body),d=this.descriptors.get(msg.eventid??-1);
+     if(!d){record('gap',{reason:'event-descriptor-missing'});break;}
+     if(msg.keys.length!==d.keys.length)throw new Error('Event key count mismatch');
+     const fields:Record<string,unknown>=Object.create(null);
+     for(let i=0;i<d.keys.length;i++){
+      const definition=d.keys[i]!,value=msg.keys[i]!;
+      if(value.type!==undefined&&value.type!==definition.type)throw new Error('Event key type mismatch');
+      const type=definition.type!;
+      fields[definition.name!]=type===1?value.val_string??'':type===2?value.val_float??0:
+       type===3||type===8?value.val_long??0:type===4||type===9?value.val_short??0:
+       type===5?value.val_byte??0:type===6?value.val_bool??false:type===7?value.val_uint64??'0':null;
+     }
+     record('raw-event',{name:d.name,eventId:d.eventid,descriptorGeneration:this.descriptorGeneration,
+      fields:Object.freeze(fields),eventServerTick:msg.server_tick??null,committedTick:this.snapshots.lastTick,
+      map:this.server?.map_name??null,tickInterval:this.server?.tick_interval??null,
+      ...projectNativeEvent(this.schema,this.snapshots,this.tables,d.name!,fields,new Map(d.keys.map(k=>[k.name!,k.type!]))) });break;
+    }
+    default:break; // Control owner handles its registered messages; no commands execute here.
+   }
+   record('checkpoint',{schemaReady:this.ready,schemaFields:this.ready?this.serializers!.fields.length:0,serverInfo:!this.halted&&this.server!==undefined,stringTables:this.tables.count,committedTick:this.snapshots.lastTick});
+  }catch(error){
+   // A failed ordered message cannot lead to an ACK from a later unrelated
+   // delta. Keep last visible entities but explicitly retire snapshot authority.
+   const reason=error instanceof Error?error.message:'decode-failed';
+   if(input.messageId===207){record('gap',{reason});}
+   else{
+    this.snapshots.recover();
+    this.lastCursor=-Infinity;
+    if(input.messageId!==55)this.halted=true;
+    record('recovery',{reason,snapshotEpoch:this.snapshots.epoch,worldReinitialization:this.halted});
+   }
+   record('checkpoint',{schemaReady:this.ready,schemaFields:this.ready?this.serializers!.fields.length:0,serverInfo:!this.halted&&this.server!==undefined,stringTables:this.tables.count,committedTick:this.snapshots.lastTick});
+  }
+  return Object.freeze(output);
+ }
+}
diff --git a/src/parser/entities/nativePacketEntities.ts b/src/parser/entities/nativePacketEntities.ts
