{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Starfie1d1272/cs2-headless-observer/schemas/managed-event.schema.json",
  "title": "CS2 observer managed JSON record, contract 3",
  "description": "cs2-observer-managed-json/3 stdout JSONL record schema. Each connection attempt increments channel; each world reset within a channel increments world; sequence is strictly contiguous from 1.",
  "type": "object",
  "required": [
    "kind",
    "channel",
    "world",
    "sequence"
  ],
  "properties": {
    "kind": {
      "enum": [
        "session-start",
        "discontinuity",
        "cursor",
        "event"
      ]
    },
    "channel": {
      "type": "integer",
      "minimum": 1
    },
    "world": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session-start"
          }
        }
      },
      "then": {
        "required": [
          "protocol"
        ],
        "properties": {
          "protocol": {
            "const": 3
          },
          "world": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "discontinuity"
          }
        }
      },
      "then": {
        "required": [
          "scope",
          "reason"
        ],
        "properties": {
          "scope": {
            "enum": [
              "connection",
              "world",
              "snapshot"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cursor"
          }
        }
      },
      "then": {
        "required": [
          "committedTick",
          "tickInterval",
          "map",
          "roundClock"
        ],
        "properties": {
          "committedTick": {
            "type": "integer",
            "minimum": 1
          },
          "tickInterval": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "map": {
            "type": "string",
            "minLength": 1
          },
          "warmup": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "round": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "roundClock": {
            "type": "object",
            "required": [
              "totalRoundsPlayed",
              "phase",
              "startTime",
              "duration",
              "committedTick",
              "freezePeriod",
              "warmupPeriod",
              "bombPlanted",
              "pause",
              "status",
              "roundInProgress",
              "roundWinStatus"
            ],
            "properties": {
              "totalRoundsPlayed": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "phase": {
                "enum": [
                  "warmup",
                  "freezetime",
                  "live",
                  "over",
                  "unknown"
                ]
              },
              "startTime": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "duration": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 2147483647
              },
              "committedTick": {
                "type": "integer",
                "minimum": 1
              },
              "freezePeriod": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "warmupPeriod": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "bombPlanted": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "pause": {
                "type": "object",
                "required": [
                  "active",
                  "totalPausedTicks",
                  "startTick",
                  "technical",
                  "semantics"
                ],
                "properties": {
                  "active": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "totalPausedTicks": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "startTick": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "technical": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "semantics": {
                    "enum": [
                      "unknown",
                      "verified"
                    ]
                  }
                }
              },
              "status": {
                "enum": [
                  "available",
                  "partial",
                  "unavailable"
                ]
              },
              "roundInProgress": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "roundWinStatus": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": -2147483648,
                "maximum": 2147483647
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "event"
          }
        }
      },
      "then": {
        "required": [
          "name",
          "eventTick",
          "committedTick",
          "fields",
          "players"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "eventTick": {
            "type": "integer"
          },
          "committedTick": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tickInterval": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "map": {
            "type": [
              "string",
              "null"
            ]
          },
          "warmup": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "round": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "residenceUs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "fields": {
            "type": "object"
          },
          "players": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/$defs/player"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "entityHandle": {
      "type": "object",
      "required": [
        "index",
        "serial"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "serial": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "player": {
      "type": "object",
      "required": [
        "domain",
        "slot",
        "steamId",
        "userId",
        "controller"
      ],
      "properties": {
        "domain": {
          "const": "player-controller-slot"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "steamId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "userId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "controller": {
          "$ref": "#/$defs/entityHandle"
        }
      },
      "additionalProperties": true
    }
  }
}
